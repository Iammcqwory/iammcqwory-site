---
import "../styles/global.css";

const pageTitle = "Makori Brian | Photography, Cinematography & Content in Nairobi";
const pageDescription =
  "Photography, cinematography, live performance coverage, artist content, campaign assets, and short-form reels by Makori Brian in Nairobi, Kenya.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href="https://iammcqwory.vercel.app/creative" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://iammcqwory.vercel.app/creative" />
    <meta property="og:image" content="https://iammcqwory.vercel.app/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="https://iammcqwory.vercel.app/og-image.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Mono:wght@300;400;500&family=Syne:wght@400;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=DM+Mono:wght@300;400;500&family=Syne:wght@400;700;800&display=swap" /></noscript>
  </head>
  <body>
    <div class="site">
      <nav class="nav" aria-label="Primary navigation">
        <a class="nav-logo" href="/">IAMMCQWORY</a>
        <ul class="nav-links nav-links-static">
          <li><a href="/#work">Work</a></li>
          <li><a href="/#ventures">Ventures</a></li>
          <li><a href="/#labs">Waziri Collective Labs</a></li>
          <li><a href="/creative" aria-current="page">Creative</a></li>
        </ul>
        <a class="nav-cta" href="https://wa.me/254719315905" target="_blank" rel="noopener">Book a production</a>
      </nav>

      <main>
        <section class="creative-hero">
          <div>
            <div class="hero-eyebrow">Nairobi, Kenya / @iammcqwory</div>
            <h1 class="creative-page-title">Stories that look good and move the work forward.</h1>
            <p class="creative-page-lede">
              I create photography, cinematography, short-form content, and campaign assets for
              artists, founders, brands, and cultural organisations.
            </p>
          </div>
          <div class="creative-hero-note">
            <span class="operator-kicker">Creative practice</span>
            <p>
              Photography, video, editorial thinking, and content strategy brought together to make
              useful, well-crafted assets that support an audience, a launch, or the next opportunity.
            </p>
          </div>
        </section>

        <section class="creative-page-section" id="services">
          <div class="section-header">
            <h2 class="section-title">What I do</h2>
            <span class="section-num">01 / 04</span>
          </div>
          <div class="creative-service-grid">
            <article><span>01</span><h3>Event &amp; performance coverage</h3><p>Concerts, live performances, ceremonies, activations, and cultural events with edited photography and selected social assets.</p></article>
            <article><span>02</span><h3>Artist &amp; founder stories</h3><p>Portraits, interviews, profile films, and behind-the-scenes content for public-facing people and teams.</p></article>
            <article><span>03</span><h3>Campaign &amp; launch content</h3><p>Photography, short-form video, reels, and launch assets for albums, products, brands, and public campaigns.</p></article>
            <article><span>04</span><h3>Content repurposing</h3><p>Edited reels, vertical clips, social-ready cutdowns, and content batches that create more value from one shoot.</p></article>
            <article><span>05</span><h3>Outdoor, hospitality &amp; lifestyle</h3><p>Landscapes, trails, interiors, architecture, hospitality details, environmental portraits, and destination storytelling.</p></article>
            <article><span>06</span><h3>Media systems</h3><p>Content planning, asset direction, production workflows, and delivery structure for creators and organisations.</p></article>
          </div>
        </section>

        <section class="creative-page-section creative-packages" id="packages">
          <div class="section-header">
            <h2 class="section-title">Featured packages</h2>
            <span class="section-num">02 / 04</span>
          </div>
          <div class="package-grid">
            <article class="package-card"><span class="case-index">01</span><h3>Live Performance Coverage</h3><strong class="package-price">KES 40,000</strong><p>Photography coverage for a live performance, event, or cultural moment with an edited digital gallery and approximately 48-hour delivery.</p><small>Best for artists, organisers, venues, and cultural organisations.</small><a class="case-link" href="https://wa.me/254719315905" target="_blank" rel="noopener">Book live performance coverage</a></article>
            <article class="package-card"><span class="case-index">02</span><h3>Performance Coverage + 3 Edited Reels</h3><strong class="package-price">KES 70,000</strong><p>Photo coverage plus three smooth, synced short-form reels in Instagram, TikTok, and vertical formats.</p><small>Best for artists, campaigns, launches, and events needing photo and video from one production.</small><a class="case-link" href="https://wa.me/254719315905" target="_blank" rel="noopener">Book the photo + reels package</a></article>
            <article class="package-card"><span class="case-index">03</span><h3>Hospitality, Adventure &amp; Lifestyle Story</h3><strong class="package-price">Quoted on request</strong><p>A tailored visual package for hotels, lodges, restaurants, travel companies, outdoor experiences, property brands, wellness retreats, and premium lifestyle businesses.</p><small>Quote depends on location, shoot days, travel, usage rights, crew, and deliverable volume.</small><a class="case-link" href="https://wa.me/254719315905" target="_blank" rel="noopener">Request a lifestyle quote</a></article>
          </div>
        </section>

        <section class="creative-page-section" id="additional-services">
          <div class="section-header">
            <h2 class="section-title">Additional services</h2>
            <span class="section-num">03 / 04</span>
          </div>
          <div class="rate-list">
            <div><strong>Interview</strong><span>From KES 40,000</span><p>Single-subject, single-day interview production.</p></div>
            <div><strong>Album / Promo Shoot</strong><span>From KES 80,000</span><p>Photography and/or video production for one to two locations.</p></div>
            <div><strong>Album Launch Coverage</strong><span>From KES 150,000</span><p>Full launch-event coverage with a multi-asset photo and video set.</p></div>
            <div><strong>Artist Tour Coverage</strong><span>From KES 40,000 per day</span><p>Day-rate coverage; travel and accommodation quoted separately.</p></div>
            <div><strong>Music Video BTS</strong><span>From KES 15,000</span><p>Behind-the-scenes coverage during an existing music-video shoot.</p></div>
            <div><strong>Dedicated BTS Crew</strong><span>From KES 40,000 per day</span><p>Standalone BTS crew and dedicated deliverable package.</p></div>
            <div><strong>Music Video Activation Reels</strong><span>Quoted on request</span><p>Commercial or artist-led reels for campaigns and activations.</p></div>
            <div><strong>Hotel, Hospitality &amp; Lifestyle Content</strong><span>Quoted on request</span><p>Photography and short-form video for destination and lifestyle campaigns.</p></div>
          </div>
        </section>

        <section class="creative-page-section process-section" id="process">
          <div class="section-header"><h2 class="section-title">How it works</h2><span class="section-num">04 / 04</span></div>
          <div class="process-grid">
            <div><span>01</span><h3>Share the brief</h3><p>Send the date, location, production type, creative reference, and assets you need.</p></div>
            <div><span>02</span><h3>Confirm the scope</h3><p>I recommend the right package, clarify deliverables, and confirm the production schedule.</p></div>
            <div><span>03</span><h3>Lock the booking</h3><p>A 50% non-refundable deposit confirms the booking. The balance is due on or before the event date.</p></div>
            <div><span>04</span><h3>Receive the work</h3><p>Final assets are delivered digitally according to the agreed turnaround and scope.</p></div>
          </div>
        </section>

        <section class="creative-terms">
          <span class="operator-kicker">Usage &amp; booking terms</span>
          <p>Listed packages include personal, archival, and organic social use. Commercial or promotional usage, paid ads, brand campaigns, and activations are licensed separately. Multi-day and out-of-town bookings are quoted according to travel, schedule, crew, locations, deliverables, and usage rights.</p>
        </section>

        <section class="creative-cta">
          <div><span class="operator-kicker">Start a project</span><h2>Let’s make something worth keeping.</h2><p>Send the brief for an upcoming performance, launch, campaign, interview, tour, or artist project.</p></div>
          <a class="btn-primary" href="https://wa.me/254719315905" target="_blank" rel="noopener">Message on WhatsApp</a>
        </section>
      </main>

      <footer class="footer"><div class="footer-left">IAMMCQWORY © 2026</div><div class="footer-right">Nairobi → Dubai → Global <a href="/sitemap">Sitemap</a></div></footer>
    </div>
  </body>
</html>
